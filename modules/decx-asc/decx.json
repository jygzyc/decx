{
  "manifest": 1,
  "kind": "server",
  "id": "asc",
  "description": "asc-server (pure-Python ASC adapter; on-demand DEX analysis, no JVM)",
  "release": {
    "source": "repo",
    "checksums": "SHA256SUMS",
    "format": "zip",
    "tag": "asc-server-v{version}",
    "asset": "asc-server-{version}.zip"
  },
  "binary": {
    "kind": "program",
    "path": "bin/asc-server",
    "env": "DECX_ASC_SERVER"
  },
  "launch": {
    "command": [
      "{binary}",
      "{target}",
      "--port",
      "{port}"
    ],
    "stop": "terminate",
    "trailing_args": true
  },
  "commands": [
    {
      "name": "class-source",
      "about": "Decompile one class with ASC (on-demand DEX extraction, no JVM)",
      "endpoint": "get_class_source",
      "args": [
        {
          "id": "class",
          "kind": "positional",
          "required": true,
          "help": "Fully qualified class name"
        },
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of source lines to return"
        }
      ],
      "request": [
        {
          "arg": "class",
          "field": "cls",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "limit",
          "field": "filter.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "find-refs",
      "about": "Find code references for a string/type regex or a method/field name",
      "endpoint": "find_refs",
      "args": [
        {
          "id": "query",
          "kind": "positional",
          "required": true,
          "help": "String/type regex, or a method/field name fragment"
        },
        {
          "id": "type",
          "kind": "value",
          "long": "type",
          "type": "string",
          "help": "Find type: string, type, method or field (default string)"
        },
        {
          "id": "class",
          "kind": "value",
          "long": "class",
          "type": "string",
          "help": "Restrict method/field lookups to a class pattern"
        },
        {
          "id": "fuzzy-class",
          "kind": "flag",
          "long": "fuzzy-class",
          "help": "Treat the --class pattern as fuzzy instead of precise"
        },
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of returned items"
        }
      ],
      "request": [
        {
          "arg": "query",
          "field": "query",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "type",
          "field": "type",
          "type": "string",
          "when": "always",
          "default": "string"
        },
        {
          "arg": "class",
          "field": "cls",
          "type": "string",
          "when": "set"
        },
        {
          "arg": "fuzzy-class",
          "field": "fuzzy_class",
          "type": "bool",
          "when": "always",
          "default": false
        },
        {
          "arg": "limit",
          "field": "filter.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    }
  ]
}

{
  "manifest": 1,
  "kind": "server",
  "id": "jadx",
  "description": "jadx-server.jar under a JVM (JADX-based, supports --script)",
  "release": {
    "source": "repo",
    "checksums": "SHA256SUMS",
    "format": "zip",
    "tag": "jadx-server-v{version}",
    "asset": "jadx-server-{version}.zip"
  },
  "binary": {
    "kind": "java-jar",
    "path": "jadx-server.jar",
    "env": "DECX_JADX_SERVER"
  },
  "launch": {
    "command": [
      "java",
      "-jar",
      "{binary}",
      "{target}",
      "--port",
      "{port}"
    ],
    "stop": "terminate",
    "scripts": "positional",
    "trailing_args": true
  },
  "commands": [
    {
      "name": "classes",
      "about": "List decompiled classes with optional package filters",
      "endpoint": "get_classes",
      "args": [
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of returned items"
        },
        {
          "id": "include-package",
          "kind": "multi",
          "long": "include-package",
          "help": "Include only names matching this package pattern; repeatable"
        },
        {
          "id": "exclude-package",
          "kind": "multi",
          "long": "exclude-package",
          "help": "Exclude names matching this package pattern; repeatable"
        },
        {
          "id": "no-regex",
          "kind": "flag",
          "long": "no-regex",
          "help": "Treat patterns as literal text instead of regular expressions"
        }
      ],
      "request": [
        {
          "arg": "limit",
          "field": "filter.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "include-package",
          "field": "filter.includes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "exclude-package",
          "field": "filter.excludes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "no-regex",
          "field": "filter.regex",
          "type": "bool",
          "when": "set",
          "invert": true
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "search-global",
      "about": "Search globally across class names and decompiled class source",
      "endpoint": "search_global_key",
      "args": [
        {
          "id": "keyword",
          "kind": "positional",
          "required": true,
          "help": "Search keyword (e.g. a class or method name fragment)"
        },
        {
          "id": "case-sensitive",
          "kind": "flag",
          "long": "case-sensitive",
          "help": "Match keyword with case sensitivity"
        },
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of returned items"
        },
        {
          "id": "include-package",
          "kind": "multi",
          "long": "include-package",
          "help": "Include only names matching this package pattern; repeatable"
        },
        {
          "id": "exclude-package",
          "kind": "multi",
          "long": "exclude-package",
          "help": "Exclude names matching this package pattern; repeatable"
        },
        {
          "id": "no-regex",
          "kind": "flag",
          "long": "no-regex",
          "help": "Treat patterns as literal text instead of regular expressions"
        }
      ],
      "request": [
        {
          "arg": "keyword",
          "field": "key",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "limit",
          "field": "search.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "include-package",
          "field": "search.includes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "exclude-package",
          "field": "search.excludes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "case-sensitive",
          "field": "search.caseSensitive",
          "type": "bool",
          "when": "always",
          "default": false
        },
        {
          "arg": "no-regex",
          "field": "search.regex",
          "type": "bool",
          "when": "always",
          "invert": true
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "class-context",
      "about": "Show one class with fields, methods, and inheritance context",
      "endpoint": "get_class_context",
      "args": [
        {
          "id": "class",
          "kind": "positional",
          "required": true,
          "help": "Fully qualified class name"
        }
      ],
      "request": [
        {
          "arg": "class",
          "field": "cls",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "class-source",
      "about": "Return decompiled source for one class",
      "endpoint": "get_class_source",
      "args": [
        {
          "id": "class",
          "kind": "positional",
          "required": true,
          "help": "Fully qualified class name"
        },
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of source lines to return"
        },
        {
          "id": "smali",
          "kind": "flag",
          "long": "smali",
          "help": "Return smali output instead of source"
        }
      ],
      "request": [
        {
          "arg": "class",
          "field": "cls",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "limit",
          "field": "filter.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "smali",
          "field": "smali",
          "type": "bool",
          "when": "always",
          "default": false
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "method-source",
      "about": "Return decompiled source for one method",
      "endpoint": "get_method_source",
      "args": [
        {
          "id": "signature",
          "kind": "positional",
          "required": true,
          "help": "Method signature (Lpkg/Cls;->name(args)ret)"
        },
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of source lines to return"
        },
        {
          "id": "smali",
          "kind": "flag",
          "long": "smali",
          "help": "Return smali output instead of source"
        }
      ],
      "request": [
        {
          "arg": "signature",
          "field": "mth",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "limit",
          "field": "filter.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "smali",
          "field": "smali",
          "type": "bool",
          "when": "always",
          "default": false
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "method-context",
      "about": "Show callers, callees, and metadata for one method",
      "endpoint": "get_method_context",
      "args": [
        {
          "id": "signature",
          "kind": "positional",
          "required": true,
          "help": "Method signature"
        }
      ],
      "request": [
        {
          "arg": "signature",
          "field": "mth",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "method-cfg",
      "about": "Return the control-flow graph for one method",
      "endpoint": "get_method_cfg",
      "args": [
        {
          "id": "signature",
          "kind": "positional",
          "required": true,
          "help": "Method signature"
        }
      ],
      "request": [
        {
          "arg": "signature",
          "field": "mth",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "search-class",
      "about": "Search source text inside one class",
      "endpoint": "search_class_key",
      "args": [
        {
          "id": "class",
          "kind": "positional",
          "required": true,
          "help": "Fully qualified class name"
        },
        {
          "id": "pattern",
          "kind": "positional",
          "required": true,
          "help": "Text or regex to find"
        },
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "required": true,
          "help": "Maximum number of matching source lines"
        },
        {
          "id": "case-sensitive",
          "kind": "flag",
          "long": "case-sensitive",
          "help": "Match pattern with case sensitivity"
        },
        {
          "id": "no-regex",
          "kind": "flag",
          "long": "no-regex",
          "help": "Treat pattern as literal text"
        }
      ],
      "request": [
        {
          "arg": "class",
          "field": "cls",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "pattern",
          "field": "key",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "limit",
          "field": "grep.limit",
          "type": "u64",
          "when": "always",
          "default": 0
        },
        {
          "arg": "case-sensitive",
          "field": "grep.caseSensitive",
          "type": "bool",
          "when": "always",
          "default": false
        },
        {
          "arg": "no-regex",
          "field": "grep.regex",
          "type": "bool",
          "when": "always",
          "invert": true
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "search-method",
      "about": "Find method signatures by simple or partial method name",
      "endpoint": "search_method",
      "args": [
        {
          "id": "name",
          "kind": "positional",
          "required": true,
          "help": "Method name fragment"
        }
      ],
      "request": [
        {
          "arg": "name",
          "field": "mth",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "xref-method",
      "about": "Find callers and references to one method",
      "endpoint": "get_method_xref",
      "args": [
        {
          "id": "signature",
          "kind": "positional",
          "required": true,
          "help": "Method signature"
        }
      ],
      "request": [
        {
          "arg": "signature",
          "field": "mth",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "xref-class",
      "about": "Find usages of one class",
      "endpoint": "get_class_xref",
      "args": [
        {
          "id": "class",
          "kind": "positional",
          "required": true,
          "help": "Fully qualified class name"
        }
      ],
      "request": [
        {
          "arg": "class",
          "field": "cls",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "xref-field",
      "about": "Find reads and writes of one field",
      "endpoint": "get_field_xref",
      "args": [
        {
          "id": "field",
          "kind": "positional",
          "required": true,
          "help": "Field signature or name"
        }
      ],
      "request": [
        {
          "arg": "field",
          "field": "fld",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "implementations",
      "about": "Find classes implementing one interface",
      "endpoint": "get_implementations",
      "args": [
        {
          "id": "interface",
          "kind": "positional",
          "required": true,
          "help": "Fully qualified interface name"
        }
      ],
      "request": [
        {
          "arg": "interface",
          "field": "iface",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "subclasses",
      "about": "Find subclasses of one class",
      "endpoint": "get_subclasses",
      "args": [
        {
          "id": "class",
          "kind": "positional",
          "required": true,
          "help": "Fully qualified class name"
        }
      ],
      "request": [
        {
          "arg": "class",
          "field": "cls",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "manifest",
      "about": "Return the decoded AndroidManifest.xml of the loaded app",
      "endpoint": "get_app_manifest",
      "args": [],
      "request": [
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "launcher-activity",
      "about": "Return the launcher activity component",
      "endpoint": "get_main_activity",
      "args": [],
      "request": [
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "application",
      "about": "Return the application class context",
      "endpoint": "get_application",
      "args": [],
      "request": [
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "exported-components",
      "about": "List exported components from the manifest",
      "endpoint": "get_exported_components",
      "args": [
        {
          "id": "include",
          "kind": "multi",
          "long": "include",
          "help": "Include names matching this pattern; repeatable"
        },
        {
          "id": "exclude",
          "kind": "multi",
          "long": "exclude",
          "help": "Exclude names matching this pattern; repeatable"
        },
        {
          "id": "no-regex",
          "kind": "flag",
          "long": "no-regex",
          "help": "Treat patterns as literal text"
        }
      ],
      "request": [
        {
          "arg": "include",
          "field": "includes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "exclude",
          "field": "excludes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "no-regex",
          "field": "regex",
          "type": "bool",
          "when": "set",
          "invert": true
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "deep-links",
      "about": "List deep links declared by the app",
      "endpoint": "get_deep_links",
      "args": [],
      "request": [
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "dynamic-receivers",
      "about": "List dynamically registered receivers",
      "endpoint": "get_dynamic_receivers",
      "args": [
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of returned items"
        },
        {
          "id": "include-package",
          "kind": "multi",
          "long": "include-package",
          "help": "Include only names matching this pattern; repeatable"
        },
        {
          "id": "exclude-package",
          "kind": "multi",
          "long": "exclude-package",
          "help": "Exclude names matching this pattern; repeatable"
        },
        {
          "id": "no-regex",
          "kind": "flag",
          "long": "no-regex",
          "help": "Treat patterns as literal text"
        }
      ],
      "request": [
        {
          "arg": "limit",
          "field": "filter.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "include-package",
          "field": "filter.includes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "exclude-package",
          "field": "filter.excludes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "no-regex",
          "field": "filter.regex",
          "type": "bool",
          "when": "set",
          "invert": true
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "framework-service-implementation",
      "about": "Find the implementation of one framework system service",
      "endpoint": "get_system_service_impl",
      "args": [
        {
          "id": "interface",
          "kind": "positional",
          "required": true,
          "help": "System service interface name"
        }
      ],
      "request": [
        {
          "arg": "interface",
          "field": "iface",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "resources",
      "about": "List resource files inside the app",
      "endpoint": "get_all_resources",
      "args": [
        {
          "id": "include",
          "kind": "multi",
          "long": "include",
          "help": "Resource file-name filter; repeatable"
        },
        {
          "id": "no-regex",
          "kind": "flag",
          "long": "no-regex",
          "help": "Treat patterns as literal text"
        }
      ],
      "request": [
        {
          "arg": "include",
          "field": "filter.includes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "no-regex",
          "field": "filter.regex",
          "type": "bool",
          "when": "set",
          "invert": true
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "resource-file",
      "about": "Return one resource file entry",
      "endpoint": "get_resource_file",
      "args": [
        {
          "id": "res",
          "kind": "positional",
          "required": true,
          "help": "Resource file path"
        }
      ],
      "request": [
        {
          "arg": "res",
          "field": "res",
          "type": "string",
          "when": "always"
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "strings",
      "about": "Return app string resources",
      "endpoint": "get_strings",
      "args": [],
      "request": [
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    },
    {
      "name": "aidl-interfaces",
      "about": "List AIDL interfaces declared by the app",
      "endpoint": "get_aidl_interfaces",
      "args": [
        {
          "id": "limit",
          "kind": "value",
          "long": "limit",
          "type": "u64",
          "help": "Maximum number of returned items"
        },
        {
          "id": "include-package",
          "kind": "multi",
          "long": "include-package",
          "help": "Include only names matching this pattern; repeatable"
        },
        {
          "id": "exclude-package",
          "kind": "multi",
          "long": "exclude-package",
          "help": "Exclude names matching this pattern; repeatable"
        },
        {
          "id": "no-regex",
          "kind": "flag",
          "long": "no-regex",
          "help": "Treat patterns as literal text"
        }
      ],
      "request": [
        {
          "arg": "limit",
          "field": "filter.limit",
          "type": "u64",
          "when": "set"
        },
        {
          "arg": "include-package",
          "field": "filter.includes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "exclude-package",
          "field": "filter.excludes",
          "type": "string[]",
          "when": "always",
          "default": []
        },
        {
          "arg": "no-regex",
          "field": "filter.regex",
          "type": "bool",
          "when": "set",
          "invert": true
        },
        {
          "arg": "page",
          "field": "page",
          "type": "u64",
          "when": "always",
          "default": 1
        }
      ]
    }
  ]
}

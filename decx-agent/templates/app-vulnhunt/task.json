{
  "task": {
    "name": "decx-app-vulnhunt",
    "session": "replace-with-session",
    "target": "replace-with-apk-path",
    "goal": "Analyze one Android APK with DECX, produce XML-backed app-layer vulnerability findings, and stop only when evidence satisfies the promotion gate."
  },
  "worker": "codex",
  "skills": [
    "skills/decx-cli",
    "skills/decx-app-vulnhunt",
    "skills/decx-subagent",
    "skills/decx-report",
    "skills/decx-poc"
  ],
  "roles": {
    "planner": {
      "prompt": "prompts/planner.md",
      "worker": "codex",
      "autonomy": {
        "canCreateIntents": true,
        "maxIntentsPerStep": 3
      }
    },
    "dispatcher": {
      "prompt": "prompts/dispatcher.md",
      "worker": "codex",
      "autonomy": {
        "canCreateIntents": true,
        "canCompleteRun": true,
        "canFailRun": true,
        "maxIntentsPerStep": 3
      }
    },
    "appCollector": {
      "extends": "explorer",
      "prompt": "prompts/app-collector.md",
      "worker": "codex",
      "capabilities": [
        "decx_cli",
        "apk_attack_surface_collection",
        "xml_artifacts"
      ],
      "autonomy": {
        "canCreateIntents": true,
        "maxIntentsPerStep": 2
      }
    },
    "chainTracer": {
      "extends": "explorer",
      "prompt": "prompts/chain-tracer.md",
      "worker": "codex",
      "capabilities": [
        "single_chain_trace",
        "guard_check",
        "sink_check",
        "xml_handoff"
      ],
      "autonomy": {
        "canCreateIntents": true,
        "maxIntentsPerStep": 1
      }
    },
    "reviewer": {
      "prompt": "prompts/reviewer.md",
      "worker": "codex",
      "autonomy": {
        "canReview": true
      }
    }
  },
  "workflow": {
    "phases": [
      { "id": "bootstrap", "role": "planner" },
      { "id": "reason", "role": "dispatcher" },
      { "id": "explore", "role": "appCollector" },
      { "id": "review", "role": "reviewer" }
    ],
    "review": {
      "enabled": true,
      "role": "reviewer",
      "worker": "codex",
      "everySteps": 5,
      "prompt": "prompts/reviewer.md"
    },
    "rules": [
      {
        "id": "route-candidate-chain",
        "when": {
          "eventType": "candidate.chain.ready"
        },
        "then": [
          {
            "createIntent": {
              "description": "Create or update exactly one chain-level XML handoff and deep-trace the assigned app source-to-sink path.",
              "role": "chainTracer",
              "fromEvent": true
            }
          }
        ]
      },
      {
        "id": "complete-on-report-ready-finding",
        "when": {
          "eventType": "finding.report_ready",
          "minSeverity": "medium"
        },
        "then": [
          {
            "completeRun": {
              "description": "At least one XML-backed app finding is report-ready."
            }
          }
        ]
      }
    ]
  },
  "workers": {
    "codex": {
      "kind": "command",
      "command": "codex",
      "args": ["exec", "{{prompt}}"]
    }
  }
}

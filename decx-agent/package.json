{
  "name": "@jygzyc/decx-agent",
  "version": "0.1.0",
  "description": "Standalone configured agent runtime",
  "type": "module",
  "files": [
    "dist",
    "templates",
    "README.md",
    "AGENTS.md"
  ],
  "bin": {
    "decx-agent": "dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist dist-packages",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "pack:agent": "node scripts/pack-compressed.mjs",
    "pack:compressed": "node scripts/pack-compressed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "commander": "^13.0.0",
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "GPL-3.0"
}

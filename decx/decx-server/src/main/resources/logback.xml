<configuration>
    <!-- DECX logs -->
    <logger name="jadx.plugins.decx" level="INFO"/>

    <!-- Suppress noisy third-party INFO logs (MCP SDK, Ktor, kotlinx) -->
    <logger name="io.modelcontextprotocol" level="WARN"/>
    <logger name="io.ktor" level="WARN"/>
    <logger name="kotlinx" level="WARN"/>

    <root level="INFO">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%level : %logger{0} - %msg%n</pattern>
            </encoder>
        </appender>
    </root>
</configuration>

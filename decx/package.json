{
  "name": "@jygzyc/decx-cli",
  "version": "0.1.0",
  "private": true,
  "description": "DECX toolkit: installs and manages the native analysis tools the DECX skills use",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "decx": "dist/decx.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\" \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pack": "node scripts/pack.mjs",
    "decx": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}

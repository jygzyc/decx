{
  "name": "@jygzyc/decx-cli",
  "version": "5.0.0",
  "description": "DECX toolkit: installs and manages the native analysis tools the DECX skills use",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "decx": "dist/decx.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jygzyc/decx.git",
    "directory": "decx"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 tests/catalog.test.ts tests/process.test.ts tests/manager.e2e.ts tests/bin-tool.e2e.ts tests/js-tool.e2e.ts tests/python-tool.e2e.ts tests/release.e2e.mjs",
    "test:functional": "node --test tests/functional/*.e2e.ts",
    "test:functional:droidasc": "node --test tests/functional/droidasc.e2e.ts",
    "test:functional:kuna": "node --test tests/functional/kuna.e2e.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "decx": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "execa": "^10.1.1",
    "typescript": "^5.9.0"
  }
}

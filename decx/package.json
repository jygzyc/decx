{
  "name": "@jygzyc/decx-cli",
  "version": "0.1.0",
  "private": true,
  "description": "DECX toolkit: installs and manages the native analysis tools the DECX skills use",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "decx": "dist/decx.mjs"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "node --test tests/manager.e2e.ts tests/bin-tool.e2e.ts tests/js-tool.e2e.ts tests/python-tool.e2e.ts tests/release.e2e.mjs",
    "test:functional": "node --test tests/functional/*.e2e.ts",
    "test:functional:droidasc": "node --test tests/functional/droidasc.e2e.ts",
    "test:functional:kuna": "node --test tests/functional/kuna.e2e.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "setup:scriptc": "node scripts/scriptc.mjs setup",
    "compile:ts-tool": "node scripts/scriptc.mjs tool",
    "build:scriptc": "node scripts/scriptc.mjs build",
    "test:native": "node --test tests/native-runtime.e2e.ts",
    "check:native": "npm run setup:scriptc && node --test tests/scriptc-tool.e2e.ts && npm run build:scriptc && npm run test:native",
    "prepack": "npm run build",
    "pack": "node scripts/pack.mjs",
    "decx": "node src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  }
}

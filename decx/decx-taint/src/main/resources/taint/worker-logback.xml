<!--
Worker logback config: ALL logging goes to stderr. stdout is reserved for the
NDJSON protocol with the orchestrator — any stray output on stdout would
corrupt the message stream.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="pascal.taie" level="INFO"/>
    <logger name="soot" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>

{
  "manifest": 1,
  "tools": [
    {
      "repo": "acme/jsprobe",
      "id": "jsprobe",
      "summary": "Offline Node launcher integration fixture",
      "install": ["github-release"],
      "launch": { "type": "js", "commands": ["jsprobe"] },
      "release": {
        "tagPrefix": "v",
        "asset": "jsprobe-{version}.tar.gz",
        "checksums": "SHA256SUMS"
      },
      "verify": "--version"
    }
  ]
}

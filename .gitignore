# Rust
target/
**/*.rs.bk

# Python (installation/tests may create virtualenvs)
__pycache__/
*.py[cod]
.venv/
venv/

# Node dependencies
node_modules/
# Built CLI package output
decx/dist/
decx/artifacts/
decx/*.tgz

# Install roots the workflows use when they exercise the manager (.ci-home)
.ci-home/

# Local archives may contain target data; never publish them.
/archive/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# Intermediate results from agent work (never committed).
/.pi-scratch/

# Rust
target/
**/*.rs.bk

# Python (installation/tests may create virtualenvs)
__pycache__/
*.py[cod]
.venv/
venv/

# Node (skill helper scripts only)
node_modules/
# Built CLI package output
decx/dist/
decx/artifacts/

# Install roots the workflows use when they exercise the manager (.ci-home)
.ci-home/

# Raw execution records may contain target data; publish only reviewed evidence.
/raw/*
!/raw/README.md
# ...and the rule that keeps per-run traces out of the repository
!/raw/.gitignore

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

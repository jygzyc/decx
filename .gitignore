# Rust
target/
**/*.rs.bk

# Python (installation/tests may create virtualenvs)
__pycache__/
*.py[cod]
.venv/
venv/

# Node (skill helper scripts only)
node_modules/
# Built CLI package output
decx/dist/
decx/artifacts/
decx/.scriptc-toolchain/

# Install roots the workflows use when they exercise the manager (.ci-home)
.ci-home/

# Historical knowledge (including target traces) is local-only and never published.
/archive/

# Initialized project knowledge and copied execution skills are local-only.
/.decxwiki/
/.agents/skills/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# Cooperative knowledge-layer write lock (normally removed after each operation).
/.pi/decx-write.lock/

# Intermediate results from agent work (never committed).
/.pi-scratch/

{
  "name": "@jygzyc/decx-cli",
  "version": "dev",
  "description": "DECX CLI - Decompiler + X",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "decx": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./sdk": {
      "import": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "node scripts/build.mjs",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.0.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "android",
    "security",
    "analysis",
    "jadx",
    "decompiler",
    "cli",
    "decx"
  ],
  "author": "Yves",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jygzyc/decx.git"
  },
  "bugs": {
    "url": "https://github.com/jygzyc/decx/issues"
  },
  "homepage": "https://github.com/jygzyc/decx#readme"
}

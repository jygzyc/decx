<decxAnalysisTemplate>
    <metadata>
        <name>decx-analysis-template</name>
        <version>1.0.0</version>
        <!-- kind is the type of artifact being created -->
        <kind>handoff|result</kind>

        <!-- sourceId is the stable id assigned to the analysis-chain source. -->
        <sourceId></sourceId>

        <!-- sinkId is the stable id assigned to the analysis-chain sink. -->
        <sinkId></sinkId>

        <!-- flowSig is the current analyzed class-level signature for the analysis chain. -->
        <flowSig></flowSig>

        <fileName>h_${decxSession}.xml|h_${sourceId}_${sinkId}_${flowSig}.xml|r_${sourceId}_${sinkId}_${flowSig}.xml</fileName>
        <decxSession>sessionName</decxSession>
    </metadata>

    <context>
        <!-- signature is the analysis-chain source component signature -->
        <entrypoint
            targetType="app|framework|library"
            signature="">
        </entrypoint>
        <analysis>
            <depth>1</depth>
            <entryReason></entryReason>
            <taintedVariables></taintedVariables>
            <analyzedChains>
                <!-- Call nodes representing the analysis chain -->
                <!-- decxSession means the session to which the call belongs -->
                <call decxSession="sessionName" signature="" depth="" result=""></call>
            </analyzedChains>
        </analysis>
    </context>

    <results>
        <!-- Repeat result when the same flowSig class contains multiple independent issues. -->
        <result>
            <trigger></trigger>
            <type>"entrypoint|source|guard|pass-through|sink|dead-end"</type>
            <!-- The signature of the component being analyzed -->
            <signature></signature>
            <isFinal>false</isFinal>
            <status>candidate|statically-supported|rejected</status>
            <impact></impact>
            <rating></rating>
            <beforeHop decxSession="sessionName" signature=""></beforeHop>
            <nextHop decxSession="sessionName" signature="" goal="" stopWhen="sink|blocking-guard|dead-end|next-hop"></nextHop>
            <evidence></evidence>
            <missingProof></missingProof>
            <blocker></blocker>
            <rationale></rationale>
            <pocReady>false</pocReady>
            <poc>
                <trigger></trigger>
                <steps></steps>
                <expectedResult></expectedResult>
                <successSignal></successSignal>
                <requirements></requirements>
            </poc>
        </result>
    </results>
</decxAnalysisTemplate>

{
  "$schema": "./decx-tool.schema.json",
  "manifest": 1,
  "tools": [
    {
      "id": "afe",
      "summary": "Android framework collection and preprocessing: pull framework files, expand them and pack an analyzable jar (AFE)",
      "repo": "jygzyc/decx",
      "license": "Apache-2.0",
      "install": ["github-release"],
      "release": {
        "assets": {
          "darwin-arm64": "afe-v{version}-darwin-arm64.tar.gz",
          "darwin-amd64": "afe-v{version}-darwin-amd64.tar.gz",
          "linux-amd64": "afe-v{version}-linux-amd64.tar.gz",
          "linux-arm64": "afe-v{version}-linux-arm64.tar.gz",
          "win-amd64": "afe-v{version}-win-amd64.zip",
          "win-arm64": "afe-v{version}-win-arm64.zip"
        }
      },
      "launch": { "type": "bin", "commands": ["afe"] },
      "verify": "--help"
    },
    {
      "id": "droidasc",
      "summary": "APK/DEX analysis on demand: class lookup and reference search (upstream DroidASC, pure Python, no JVM)",
      "repo": "MG1937/ASC",
      "license": "Apache-2.0",
      "env": {},
      "requires": "python",
      "install": ["pip", "install", "droidasc"],
      "launch": { "type": "python", "commands": ["droidasc"] },
      "verify": "--help"
    },
    {
      "id": "kuna",
      "summary": "Native decompiler for ELF/PE/Mach-O: functions, pseudo-C, xrefs, disassembly (upstream Kuna)",
      "repo": "Noelo-Lab/kuna",
      "license": "Apache-2.0",
      "env": { "KUNA_SPECS": "{prefix}/specs" },
      "requires": "bin",
      "install": ["github-release"],
      "release": {
        "assets": {
          "darwin-arm64": "kuna-v{version}-macos-arm64.tar.gz",
          "darwin-amd64": "kuna-v{version}-macos-x86_64.tar.gz",
          "linux-amd64": "kuna-v{version}-linux-x86_64.tar.gz",
          "linux-arm64": "kuna-v{version}-linux-arm64.tar.gz",
          "win-amd64": "kuna-v{version}-windows-x86_64.zip"
        },
        "extraAssets": { "specs": "kuna-v{version}-specs.tar.gz" }
      },
      "launch": { "type": "bin", "commands": ["kuna", "decomp_dbg", "slacomp"] },
      "verify": "--version"
    }
  ]
}

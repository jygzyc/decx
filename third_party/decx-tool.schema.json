{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jygzyc/decx/main/third_party/decx-tool.schema.json",
  "title": "DECX tool catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "tools"],
  "properties": {
    "$schema": { "const": "./decx-tool.schema.json" },
    "manifest": { "const": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "summary", "install", "launch"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "license": { "type": "string" },
        "notes": { "type": "string" },
        "install": {
          "description": "Installer recipe: [\"github-release\"] for native or JS archives, or [\"pip\", \"install\", package] for Python. DECX owns staging and any virtual environment.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "launch": {
          "description": "The runtime type and public commands. The first command is the default for decx -m.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "commands"],
          "properties": {
            "type": { "enum": ["bin", "python", "js"], "description": "bin, python or js (Node scripts from a release archive)." },
            "commands": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$" }
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tagPrefix": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "checksums": { "type": ["string", "null"] },
            "asset": { "type": "string", "minLength": 1 },
            "assets": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
            "extraAssets": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
          }
        },
        "requires": { "enum": ["bin", "python", "js"], "description": "Must match launch.type; inferred when omitted." },
        "env": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "verify": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "if": { "properties": { "requires": { "const": "bin" } }, "required": ["requires"] }, "then": { "properties": { "launch": { "properties": { "type": { "const": "bin" } } } } } },
        { "if": { "properties": { "requires": { "const": "python" } }, "required": ["requires"] }, "then": { "properties": { "launch": { "properties": { "type": { "const": "python" } } } } } },
        { "if": { "properties": { "requires": { "const": "js" } }, "required": ["requires"] }, "then": { "properties": { "launch": { "properties": { "type": { "const": "js" } } } } } },
        { "if": { "properties": { "launch": { "properties": { "type": { "enum": ["python", "js"] } } } } }, "then": { "properties": { "env": { "maxProperties": 0 } } } }
      ]
    }
  }
}

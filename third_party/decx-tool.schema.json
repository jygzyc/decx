{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jygzyc/decx/main/third_party/decx-tool.schema.json",
  "title": "DECX tool catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "tools"],
  "properties": {
    "$schema": { "const": "./decx-tool.schema.json" },
    "manifest": { "const": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "description": "Tool IDs must also be unique; the catalog loader checks this across entries.",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "stringMap": {
      "type": "object",
      "propertyNames": { "pattern": "\\S" },
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "summary", "env", "requires", "install", "launch"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "summary": { "$ref": "#/$defs/text" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$" },
        "license": { "type": "string" },
        "notes": { "type": "string" },
        "env": {
          "description": "Explicit launcher environment; use {} when empty. Non-empty maps are supported only by bin launchers. {prefix} and {version} are expanded at install time.",
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "not": { "pattern": "\\s" } },
          "additionalProperties": { "$ref": "#/$defs/text" }
        },
        "requires": { "enum": ["bin", "python", "js"], "description": "Explicit runtime kind; must match launch.type. No inferred default." },
        "install": {
          "description": "[\"github-release\"] for bin/js archives, or [\"pip\", \"install\", package, ...] for Python. DECX owns staging and the private virtual environment.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "launch": {
          "description": "Runtime type and public commands. The first command is the default for decx -m.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "commands"],
          "properties": {
            "type": { "enum": ["bin", "python", "js"] },
            "commands": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$", "not": { "pattern": "\\s" } }
            }
          }
        },
        "release": { "$ref": "#/$defs/release" },
        "verify": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        { "if": { "properties": { "requires": { "const": "bin" } }, "required": ["requires"] }, "then": { "properties": { "launch": { "properties": { "type": { "const": "bin" } } } } } },
        { "if": { "properties": { "requires": { "const": "python" } }, "required": ["requires"] }, "then": { "properties": { "launch": { "properties": { "type": { "const": "python" } } } } } },
        { "if": { "properties": { "requires": { "const": "js" } }, "required": ["requires"] }, "then": { "properties": { "launch": { "properties": { "type": { "const": "js" } } } } } },
        {
          "if": { "properties": { "requires": { "enum": ["bin", "js"] } }, "required": ["requires"] },
          "then": {
            "required": ["release"],
            "properties": { "install": { "const": ["github-release"] } }
          }
        },
        {
          "if": { "properties": { "requires": { "const": "python" } }, "required": ["requires"] },
          "then": {
            "properties": {
              "env": { "maxProperties": 0 },
              "release": false,
              "install": {
                "minItems": 3,
                "prefixItems": [
                  { "const": "pip" },
                  { "const": "install" },
                  { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" }
                ]
              },
              "launch": { "properties": { "commands": { "maxItems": 1 } } }
            }
          }
        },
        {
          "if": { "properties": { "requires": { "const": "js" } }, "required": ["requires"] },
          "then": { "properties": { "env": { "maxProperties": 0 } } }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [{ "required": ["asset"] }, { "required": ["assets"] }],
      "properties": {
        "tagPrefix": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" },
        "checksums": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "asset": { "$ref": "#/$defs/text" },
        "assets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["darwin-arm64", "darwin-amd64", "linux-amd64", "linux-arm64", "win-amd64", "win-arm64", "any"] },
          "additionalProperties": { "$ref": "#/$defs/text" }
        },
        "extraAssets": { "$ref": "#/$defs/stringMap" }
      }
    }
  }
}

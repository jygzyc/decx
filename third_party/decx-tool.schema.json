{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jygzyc/decx/main/third_party/decx-tool.schema.json",
  "title": "DECX tool manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "summary", "install", "launch"],
  "properties": {
    "$schema": { "const": "../decx-tool.schema.json" },
    "manifest": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "summary": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri" },
    "license": { "type": "string" },
    "notes": { "type": "string" },
    "install": {
      "description": "Installer recipe: [\"github-release\"] for native or JS archives, or [\"pip\", \"install\", package] for Python. DECX owns staging and any virtual environment.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "launch": {
      "description": "The runtime type and public commands. The first command is the default for decx -m.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "commands"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "description": "bin, python or js (Node scripts from a release archive)." },
        "commands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9_.-]+$" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "tagPrefix": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "checksums": { "type": ["string", "null"] },
        "asset": { "type": "string", "minLength": 1 },
        "assets": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "extraAssets": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "python": { "type": "string", "minLength": 1 } }
    },
    "env": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "verify": { "type": "string", "minLength": 1 }
  }
}
